# =====================================================================
# Biomont - example environment configuration
# Copiar a `.env` y completar con valores reales. Nunca commitear `.env`.
# =====================================================================

# --- Postgres (Railway) -----------------------------------------------
# URL completa que entrega Railway (variable DATABASE_URL del servicio Postgres).
# Formato: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# En `.env` local/Docker Compose usar siempre una URL literal. La sintaxis
# ${{ Postgres.DATABASE_URL }} solo aplica en el dashboard de Railway y hace
# fallar `docker compose` al leer el archivo.
DATABASE_URL=postgres://user:password@host:5432/biomont

# --- OpenAI -----------------------------------------------------------
OPENAI_API_KEY=sk-xxxxx
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
# Dim del modelo de embeddings configurado. text-embedding-3-small=1536,
# text-embedding-3-large=3072. Cambiar requiere reingesta TOTAL del corpus.
OPENAI_EMBEDDINGS_DIM=1536

# --- WhatsApp (Meta Cloud API) ---------------------------------------
# Phone number id que entrega Meta para tu numero de WhatsApp Business.
WHATSAPP_PHONE_NUMBER_ID=000000000000000
# Access token (long-lived) del system user con permisos sobre la app.
WHATSAPP_ACCESS_TOKEN=EAA...
# Token que vos elegis y configuras en el webhook de Meta (GET verification).
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
# App secret de Meta para validar la firma HMAC del POST del webhook.
WHATSAPP_APP_SECRET=change-me-app-secret
# Version de la Graph API de Meta.
WHATSAPP_GRAPH_API_VERSION=v20.0

# --- Agente -----------------------------------------------------------
# Umbral comparado vs top similarity del retrieval hibrido (fusion vec+BM25).
# El orquestador aplica efectivamente min(este valor, RAG_VECTOR_WEIGHT).
AGENT_SIMILARITY_THRESHOLD=0.75
AGENT_TOP_K=6
AGENT_SYSTEM_PROMPT_CACHE_TTL_SECONDS=60
# Secreto compartido para POST /internal/playground/messages (agente) y proxy del backoffice.
# En produccion usar cadena larga aleatoria; debe coincidir en ambos servicios.
# AGENT_PLAYGROUND_SECRET=

# --- RAG / Grafo del agente (spec 003/007) -----------------------------
# Pesos de la fusion (suma >0; los normalizamos en SQL).
RAG_VECTOR_WEIGHT=0.7
RAG_BM25_WEIGHT=0.3
# Cantidad de chunks finales + candidatos pre-fusion.
RAG_TOP_K=6
RAG_CANDIDATE_K=25
# Resolucion deterministica de producto (pg_trgm).
PRODUCT_RESOLVER_THRESHOLD=0.55
PRODUCT_RESOLVER_MARGIN=0.10
# true => el grafo usa todos los DocumentKind en hibrido, ignorando filtros por intent
# (solo recomendado para QA / demos).
RAG_FULL_CORPUS_FOR_ALL_INTENTS=false
# StructuredMarkdownChunker: tamano objetivo (~tokens) por fila knowledge_chunks + solapamiento.
# Subir = mas contexto por chunk (mejor QA), mas costo embedding y ventana LLM mayor.
# Cambiar requiere reingesta del documento.
RAG_KNOWLEDGE_CHUNK_TOKENS=1000
RAG_KNOWLEDGE_CHUNK_OVERLAP=120

# URL base del agente (backoffice-api → servicio agent, sin path final).
# - Docker Compose: el compose fuerza http://agent:8001.
# - Local sin Compose: suele ser http://localhost:8001.
# - Railway (prod): definir en el servicio **backoffice-api** (no en el frontend).
#   Opción simple (HTTPS, mismo proyecto Railway): plantilla en dashboard:
#     https://${{agent.RAILWAY_PUBLIC_DOMAIN}}
#   Opción por red privada (HTTP sobre mesh): conocer el puerto real del agent (log Uvicorn / PORT)
#   y usar por ejemplo http://agent.railway.internal:8080.
#   La referencia ${{agent.PORT}} no siempre aparece como variable referenciable; si queda vacía,
#   la URL queda rota (host sin puerto).
#   Si no está definida, el default del código es localhost:8001 y el proxy del
#   playground falla en prod (502: agent unreachable).
AGENT_INTERNAL_BASE_URL=http://localhost:8001

# --- Backoffice API ---------------------------------------------------
# Secret para firmar JWTs del backoffice. Usar una cadena fuerte (>=32 chars).
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# CORS origenes permitidos por el backoffice-api (lista separada por comas).
BACKOFFICE_API_CORS_ORIGINS=http://localhost:3000

# --- Frontend ---------------------------------------------------------
# backoffice-web → backoffice-api: el navegador usa NEXT_PUBLIC_API_BASE_URL; el runtime
# de Next (SSR / server actions) usa API_INTERNAL_BASE_URL si existe (nombre DNS interno).
# El playground/chat de prueba va browser→API→agent; AGENT_INTERNAL_BASE_URL va solo en backoffice-api.
# URL desde la que el navegador habla con backoffice-api (host publicado por Compose).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8002
# Solo servidor Next (SSR, server actions). En Docker Compose se define en docker-compose.yml
# como http://backoffice-api:8002; en desarrollo local sin Docker suele omitirse y usa NEXT_PUBLIC_*.
# API_INTERNAL_BASE_URL=http://backoffice-api:8002
# En producción con HTTPS, true; en Docker local sobre http://localhost, false (Compose lo fija).
# SESSION_COOKIE_SECURE=false

# --- Logging ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
